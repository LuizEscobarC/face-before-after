  "info": {
    "title": "Face Analysis Orchestrator API",
    "description": "\n# Face Before/After — Orchestrator\n\nAPI NestJS que orquestra o pipeline de análise facial sobre o vision-service (FastAPI/Python).\n\n## Módulos\n| Módulo | Descrição |\n|--------|-----------|\n| **Health** | Verificação de saúde |\n| **Vision** | Proxy para o vision-service (landmarks, métricas, full-pipeline, compare) |\n| **Photo Quality** | Gatekeeper Module 0 — valida qualidade da foto antes de avançar |\n| **Analysis** | Orquestra full-pipeline + comparação |\n        ",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Health",
      "description": ""
    },
    {
      "name": "Vision",
      "description": ""
    },
    {
      "name": "PhotoQuality",
      "description": ""
    },
    {
      "name": "Analysis",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "CaptureGuidelinesDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "distance_meters": {
            "type": "number"
          },
          "zoom": {
            "type": "string"
          },
          "tips": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title",
          "distance_meters",
          "zoom",
          "tips"
        ]
      },
      "LandmarkRequestDto": {
        "type": "object",
        "properties": {
          "image_base64": {
            "type": "string",
            "description": "Base64 da imagem (com ou sem data URL prefix)"
          },
          "session_id": {
            "type": "string"
          }
        },
        "required": [
          "image_base64"
        ]
      },
      "PoseAnglesDto": {
        "type": "object",
        "properties": {
          "yaw": {
            "type": "number"
          },
          "pitch": {
            "type": "number"
          },
          "roll": {
            "type": "number"
          }
        },
        "required": [
          "yaw",
          "pitch",
          "roll"
        ]
      },
      "LandmarkResponseDto": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "landmarks": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "pose": {
            "$ref": "#/components/schemas/PoseAnglesDto"
          },
          "quality_score": {
            "type": "number"
          },
          "quality_grade": {
            "type": "string",
            "enum": [
              "ALTA",
              "MEDIA",
              "BAIXA",
              "REJEITADA"
            ]
          },
          "flags": {
            "type": "object"
          },
          "regional_penalties": {
            "type": "object"
          },
          "recommendations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fingerprint": {
            "type": "string"
          },
          "processing_mode": {
            "type": "string"
          },
          "sharpness_score": {
            "type": "number"
          },
          "lighting_asymmetry": {
            "type": "number"
          },
          "subscore_breakdown": {
            "type": "object"
          }
        },
        "required": [
          "session_id",
          "landmarks",
          "pose",
          "quality_score",
          "quality_grade",
          "flags",
          "regional_penalties",
          "recommendations",
          "fingerprint",
          "processing_mode",
          "sharpness_score",
          "lighting_asymmetry",
          "subscore_breakdown"
        ]
      },
      "QualityContextDto": {
        "type": "object",
        "properties": {
          "quality_score": {
            "type": "number"
          },
          "regional_penalties": {
            "type": "object"
          }
        },
        "required": [
          "quality_score",
          "regional_penalties"
        ]
      },
      "MetricsRequestDto": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "landmarks": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "image_base64": {
            "type": "string"
          },
          "quality_context": {
            "$ref": "#/components/schemas/QualityContextDto"
          }
        },
        "required": [
          "landmarks",
          "quality_context"
        ]
      },
      "MetricsResponseDto": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "array"
          },
          "raw": {
            "type": "object"
          }
        },
        "required": [
          "metrics",
          "raw"
        ]
      },
      "FullPipelineRequestDto": {
        "type": "object",
        "properties": {
          "image_base64": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "premium",
              "teaser"
            ],
            "default": "premium"
          },
          "session_id": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          }
        },
        "required": [
          "image_base64"
        ]
      },
      "FullPipelineResponseDto": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string"
          },
          "output_dir": {
            "type": "string"
          },
          "photo_url": {
            "type": "string"
          },
          "result": {
            "type": "object"
          }
        },
        "required": [
          "run_id",
          "output_dir",
          "result"
        ]
      },
      "CompareRequestDto": {
        "type": "object",
        "properties": {
          "run_id_before": {
            "type": "string"
          },
          "run_id_after": {
            "type": "string"
          }
        },
        "required": [
          "run_id_before",
          "run_id_after"
        ]
      },
      "ValidatePhotoDto": {
        "type": "object",
        "properties": {
          "image_base64": {
            "type": "string",
            "description": "Imagem em base64 (com ou sem data URL prefix)"
          },
          "session_id": {
            "type": "string"
          }
        },
        "required": [
          "image_base64"
        ]
      },
      "PhotoQualityDecisionDto": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "ACCEPT",
              "WARN",
              "REJECT"
            ]
          },
          "grade": {
            "type": "string",
            "enum": [
              "ALTA",
              "MEDIA",
              "BAIXA",
              "REJEITADA"
            ]
          },
          "quality_score": {
            "type": "number"
          },
          "recommendations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fingerprint": {
            "type": "string"
          },
          "subscore_breakdown": {
            "type": "object"
          },
          "flags": {
            "type": "object"
          },
          "pose": {
            "type": "object"
          },
          "sharpness_score": {
            "type": "number"
          },
          "lighting_asymmetry": {
            "type": "number"
          },
          "session_id": {
            "type": "string"
          },
          "processing_mode": {
            "type": "string"
          }
        },
        "required": [
          "decision",
          "grade",
          "quality_score",
          "recommendations",
          "fingerprint",
          "subscore_breakdown",
          "flags",
          "pose",
          "sharpness_score",
          "lighting_asymmetry",
          "session_id",
          "processing_mode"
        ]
      },
      "AnalyzePhotoDto": {
        "type": "object",
        "properties": {
          "image_base64": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "premium",
              "teaser"
            ],
            "default": "premium"
          },
          "session_id": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "skip_quality_gate": {
            "type": "boolean",
            "default": false,
            "description": "Pula o gatekeeper Module 0 (NÃO recomendado em produção)"
          }
        },
        "required": [
          "image_base64"
        ]
      },
      "CompareRunsDto": {
        "type": "object",
        "properties": {
          "run_id_before": {
            "type": "string"
          },
          "run_id_after": {
            "type": "string"
          }
        },
        "required": [
          "run_id_before",
          "run_id_after"
        ]
      }
    }
  }
}