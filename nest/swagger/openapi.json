        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FullPipelineResponseDto"
                }
              }
            }
          }
        },
        "summary": "Roda o pipeline completo (premium ou teaser)",
        "tags": [
          "Vision"
        ]
      }
    },
    "/v1/vision/compare": {
      "post": {
        "operationId": "VisionController_compare",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompareRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Compara dois runs antes/depois",
        "tags": [
          "Vision"
        ]
      }
    },
    "/v1/vision/results/{runId}/annotated": {
      "get": {
        "operationId": "VisionController_annotated",
        "parameters": [
          {
            "name": "runId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Imagem anotada com landmarks",
        "tags": [
          "Vision"
        ]
      }
    },
    "/v1/vision/results/{runId}/simulation/{simType}": {
      "get": {
        "operationId": "VisionController_simulation",
        "parameters": [
          {
            "name": "runId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "simType",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Simulação visual (symmetrized | ideal_proportions | comparison_grid)",
        "tags": [
          "Vision"
        ]
      }
    },
    "/v1/photo-quality/validate": {
      "post": {
        "operationId": "PhotoQualityController_validate",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidatePhotoDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhotoQualityDecisionDto"
                }
              }
            }
          }
        },
        "summary": "Module 0 — valida qualidade da foto e devolve decisão (ACCEPT/WARN/REJECT)",
        "tags": [
          "PhotoQuality"
        ]
      }
    },
    "/v1/analysis": {
      "post": {
        "operationId": "AnalysisController_analyze",
        "parameters": [],
