{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "sourceMap": false,
    "declaration": false,
    "incremental": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "**/*.spec.ts", "**/*.test.ts"]
}
