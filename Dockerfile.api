# Dockerfile for API — install all dependencies fresh in Python 3.12
# syntax=docker/dockerfile:1

FROM python:3.12-slim

RUN echo 'Acquire::http::Proxy "DIRECT";' > /etc/apt/apt.conf.d/99no-proxy && \
    echo 'Acquire::https::Proxy "DIRECT";' >> /etc/apt/apt.conf.d/99no-proxy && \
    apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libgles2 \
    libegl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    curl \
    cmake \
    g++ \
    build-essential \
    libopenblas-dev \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Copy pyproject.toml first for layer caching
COPY backend/pyproject.toml ./

# Install Python dependencies (fast, no native compilation needed without dlib).
RUN pip install --no-cache-dir --target=/app/site-packages \
    "fastapi>=0.112.0" \
    "uvicorn>=0.30.0" \
    "python-multipart>=0.0.9" \
    "pydantic-settings>=2.0" \
    "requests>=2.31.0" \
    "opencv-python-headless>=4.8.0,<4.11" \
    "numpy>=1.24,<2.0" \
    "mediapipe>=0.10.18" \
    "pillow>=10.0.0" \
    "scipy>=1.11.0" \
    "minio>=7.2.0" \
    "python-dotenv>=1.0.0" \
    "reportlab>=4.2.0" \
    "onnxruntime>=1.17.0"

# Download MediaPipe FaceLandmarker model (~3MB) for Mesh-478 native detection.
RUN mkdir -p /app/backend/models && \
    curl -fsSL https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task \
        -o /app/backend/models/face_landmarker.task

# Download BiSeNet face-parsing ONNX model (~6MB, CelebAMask-HQ 19 classes, hair=17).
# URL: yakhyo/face-parsing v0.0.1 release.
# FALLBACK: If this URL returns 404, replace it with your mirror URL.
# Without this model the pipeline silently falls back to lm[10] mesh trichion (see fusion_layer.py).
RUN curl -fsSL \
    "https://github.com/yakhyo/face-parsing/releases/download/v0.0.1/bisenet_resnet18.onnx" \
    -o /app/backend/models/bisenet_face_parsing.onnx \
    || echo "WARNING: BiSeNet ONNX download failed — fallback mesh trichion will be used at runtime"

# Copy application code from backend/ package
COPY backend/ ./
COPY entrypoint.sh ./

RUN chmod +x /app/entrypoint.sh

RUN mkdir -p /app/resultado_api /app/bkp && chmod -R 777 /app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD curl -f http://localhost:8000/docs || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
