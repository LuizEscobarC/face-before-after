# Dockerfile for API — uses Python 3.12 with pre-built venv from host
# syntax=docker/dockerfile:1

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Copy pre-built venv from host
COPY .venv /app/.venv

# Copy application code
COPY api_server.py mvp_pipeline.py face.py face_asymmetry.py face_metrics.py \
     impression_layer.py recommendations.py top_leverage.py visual_status.py \
     glossary.py simulate_before_after.py compare_report.py evolution_path.py \
     build_html_report.py minio_client.py shape_predictor_68_face_landmarks.dat ./

RUN mkdir -p /app/resultado_api /app/bkp && chmod -R 777 /app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD curl -f http://localhost:8000/docs || exit 1

CMD ["/app/.venv/bin/python", "-m", "uvicorn", "api_server:app", "--host", "0.0.0.0", "--port", "8000"]
