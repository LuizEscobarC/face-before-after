# Dockerfile for API — install all dependencies fresh in Python 3.12
# syntax=docker/dockerfile:1

FROM python:3.12-slim

RUN echo 'Acquire::http::Proxy "DIRECT";' > /etc/apt/apt.conf.d/99no-proxy && \
    echo 'Acquire::https::Proxy "DIRECT";' >> /etc/apt/apt.conf.d/99no-proxy && \
    apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    curl \
    cmake \
    g++ \
    build-essential \
    libopenblas-dev \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Copy requirements first for layer caching
COPY requirements-api.txt ./

# Install dlib separately first — heavy C++ compile, cached as its own layer.
# If requirements-api.txt changes but dlib version does not, this layer is reused.
RUN pip install --no-cache-dir --target=/app/site-packages dlib>=19.24.0

# Install remaining dependencies (fast, no compilation)
RUN pip install --no-cache-dir --target=/app/site-packages \
    fastapi>=0.112.0 \
    uvicorn>=0.30.0 \
    python-multipart>=0.0.9 \
    requests>=2.31.0 \
    opencv-python-headless>=4.8.0 \
    numpy>=1.24.0 \
    pillow>=10.0.0 \
    scipy>=1.11.0 \
    minio>=7.2.0 \
    python-dotenv>=1.0.0

# Copy application code
COPY api_server.py mvp_pipeline.py face.py face_asymmetry.py face_metrics.py \
     impression_layer.py recommendations.py top_leverage.py visual_status.py \
     glossary.py simulate_before_after.py compare_report.py evolution_path.py \
     build_html_report.py minio_client.py start_api.py entrypoint.sh \
     shape_predictor_68_face_landmarks.dat ./

RUN chmod +x /app/entrypoint.sh

RUN mkdir -p /app/resultado_api /app/bkp && chmod -R 777 /app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD curl -f http://localhost:8000/docs || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
