{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompact": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/local/hooks/scripts/inject-context.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .claude/local/hooks/scripts/ask-rag-enrich.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/local/hooks/scripts/block-dangerous-bash.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/local/hooks/scripts/save-context-before-compact.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/local/hooks/scripts/save-session-summary.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}