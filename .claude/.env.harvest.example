# Read-only credentials for context-harvester. Copy to .claude/.env.harvest and fill.
# .claude/.env.harvest is gitignored. NEVER commit real credentials.
#
# Role MUST be GRANT SELECT only. Example:
#   CREATE ROLE harvester LOGIN PASSWORD '***';
#   GRANT CONNECT ON DATABASE face_before_after TO harvester;
#   GRANT USAGE ON SCHEMA public TO harvester;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO harvester;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO harvester;

PG_URL=postgresql://harvester:CHANGE_ME@localhost:5432/face_before_after

# Optional: per-statement timeout in ms (default 30000)
PG_STATEMENT_TIMEOUT_MS=30000

# Optional: anonymization seed (stable hashes across runs)
ANON_SALT=face-before-after-2026
